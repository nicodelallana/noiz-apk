# ==============================================================================
# AUTOMATED EUSKADI PUBLIC TRANSPORT PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Moveuskadi Catalog Discovery
MOVEUSKADI_CATALOG_URL=https://opendata.euskadi.eus/transport/moveuskadi/data-index.json
MOVEUSKADI_CATALOGUE_PAGE_URL=https://opendata.euskadi.eus/catalogo/-/moveuskadi-datos-de-la-red-de-transporte-publico-de-euskadi-operadores-horarios-paradas-calendario-tarifas-etc/
GEOEUSKADI_TERRITORIOS_URL=https://www.geo.euskadi.eus/cartografia/DatosDescarga/Limites/TERRITORIOS_5000_ETRS89.zip
GEOEUSKADI_MUNICIPIOS_URL=https://www.geo.euskadi.eus/cartografia/DatosDescarga/Limites/MUNICIPIOS_5000_ETRS89.zip

# Supabase PostgreSQL Database (with PostGIS)
# Example: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Supabase API & Storage
SUPABASE_URL=https://ocxcrxgagennmukuxnle.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=transit-packs

# Ingestion Worker Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
DOWNLOAD_TIMEOUT_SECONDS=60
DOWNLOAD_MAX_RETRIES=3
MAX_CONCURRENT_DOWNLOADS=5
USER_AGENT=MoveuskadiTransitBot/1.0 (+https://github.com/bizkaia-transit)

# Automation Schedules (Cron / Intervals)
CATALOG_DISCOVERY_INTERVAL_MINUTES=15
STATIC_CHECK_INTERVAL_HOURS=6
REALTIME_VEHICLES_INTERVAL_SECONDS=20
REALTIME_TRIP_UPDATES_INTERVAL_SECONDS=45
REALTIME_ALERTS_INTERVAL_MINUTES=2

# Monitoring API Server
API_HOST=0.0.0.0
API_PORT=8000
